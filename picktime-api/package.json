{
  "name": "picktime-api",
  "version": "0.1.0",
  "description": "Agentic Picktime Tool API: slots, holds, and bookings over a Playwright-driven page.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
